<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AltaProductos"
    android:padding="30dp"
    android:paddingEnd="50dp"
    android:paddingStart="50dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alta de Productos"
        android:id="@+id/txAltaProductos"
        android:textStyle="bold"
        android:textSize="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="50dp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/etCodigo"
        android:hint="Codigo del Producto"
        app:layout_constraintTop_toBottomOf="@id/txAltaProductos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/etNombreProducto"
        android:hint="Nombre del Producto"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/etCodigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/Conjunto"
        app:layout_constraintTop_toBottomOf="@id/etNombreProducto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:gravity="center">
        <EditText
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:id="@+id/etCantidadProducto"
            android:hint="Cantidad"/>
        <EditText
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:id="@+id/etPrecio"
            android:hint="Precio" />
    </LinearLayout>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/etCategoria"
        app:layout_constraintTop_toBottomOf="@id/Conjunto"
        android:hint="Categoria del Producto"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <Button
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:id="@+id/btnGuardarProducto"
        android:text="GUARDAR PRODUCTO"
        app:layout_constraintTop_toBottomOf="@id/etCategoria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"/>
    <Button
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:id="@+id/btnCancelarAlta"
        android:text="CANCELAR"
        app:layout_constraintTop_toBottomOf="@id/btnGuardarProducto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>