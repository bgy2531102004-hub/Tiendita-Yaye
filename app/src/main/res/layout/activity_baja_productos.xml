<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    tools:context=".BajaProductos">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Baja de producto"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresa el código del producto para buscarlo y proceder a su eliminación."
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"/>


    <EditText
        android:id="@+id/etCodigoBaja"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Código del producto"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>
    <Button
        android:id="@+id/btnBuscarBaja"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="BUSCAR PRODUCTO"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalles del producto"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvNombreDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre:"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvCantidadDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad:"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPrecioDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio:"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvCategoriaDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría:"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnEliminarDefinitivo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="ELIMINAR DEFINITIVAMENTE"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCancelarBaja"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="CANCELAR" />


</LinearLayout>