<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/txPanel_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panel de Control"
        android:textStyle="bold"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnAlta_Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Alta"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txPanel_control"
        app:layout_constraintEnd_toStartOf="@id/btnBaja_Panel"
        app:layout_constraintHorizontal_chainStyle="spread"/>

    <Button
        android:id="@+id/btnBaja_Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Baja"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/btnAlta_Panel"
        app:layout_constraintTop_toBottomOf="@id/txPanel_control"
        app:layout_constraintEnd_toStartOf="@id/btnBuscar_Panel"/>

    <Button
        android:id="@+id/btnBuscar_Panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Buscar"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/btnBaja_Panel"
        app:layout_constraintTop_toBottomOf="@id/txPanel_control"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txProductosRegistrados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Productos Registrados"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnAlta_Panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_PanelControl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/txProductosRegistrados"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>